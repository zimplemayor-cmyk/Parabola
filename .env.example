# --- Contracts -----------------------------------------------------------
# Fill in after running `npm run deploy:testnet` (or :mainnet) inside /contracts.
NEXT_PUBLIC_FACTORY_ADDRESS=

# 6 for the factory currently live on testnet (deployed before the
# 18-decimal rescale). 18 for any future redeploy from current contract
# source, testnet or mainnet, set this alongside a new
# NEXT_PUBLIC_FACTORY_ADDRESS, don't assume it from network. See
# lib/format.ts.
NEXT_PUBLIC_QUOTE_DECIMALS=6

# --- Network ---------------------------------------------------------------
# "true" once you're ready to point the app at Arc mainnet instead of testnet.
NEXT_PUBLIC_USE_MAINNET=false

# Only needed if you want to override the defaults baked into lib/chains.ts.
NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_MAINNET_RPC=https://rpc.arc.network
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=5042
NEXT_PUBLIC_ARC_MAINNET_EXPLORER=https://arcscan.app

# --- Wallet connect ----------------------------------------------------------
# Optional. Injected wallets (MetaMask, Rabby, etc.) work with no config.
# Get a free project ID at https://cloud.reown.com (formerly WalletConnect
# Cloud) to also support mobile/QR wallet connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Metadata ----------------------------------------------------------------
# Gateway used to resolve ipfs:// metadata image URIs to https URLs.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Powers real device-upload token images: creators pick a file in the
# Launch form, it's pinned to IPFS through app/api/upload-image and
# app/api/upload-metadata using this key. Free account: pinata.cloud ->
# API Keys -> New Key -> Admin -> copy the JWT.
PINATA_JWT=
