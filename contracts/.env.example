# Deployer wallet — needs enough native currency (USDC on Arc) to pay gas.
# NEVER commit this file with a real key filled in.
DEPLOYER_PRIVATE_KEY=

# Where protocol fees are sent. Defaults to the deployer address if unset —
# set this to a real (ideally multisig) address before taking real fees.
TREASURY_ADDRESS=

# Optional overrides — see hardhat.config.ts for defaults and the
# verification notes on the mainnet values.
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_MAINNET_RPC=https://rpc.arc.network
ARC_MAINNET_CHAIN_ID=5042
